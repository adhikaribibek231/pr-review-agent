# Copy this file to .env and fill in what you have:   cp .env.example .env
# .env is git-ignored. NEVER commit real keys. Rules for every line below:
#   * no quotes, no spaces around the "="        GROQ_API_KEY=gsk_abc123   (not  GROQ_API_KEY = "gsk_abc123")
#   * leave a variable empty (or delete the line) if you don't use that provider
#
# Every provider has its OWN fields, so nothing is shared or ambiguous. Filling in just one
# is enough. Filling in several gives you backups for when a free tier runs out.
#
# PRIVACY: some free tiers may use your prompts to improve their models. The prompts contain
# your diff and surrounding code. Read a provider's terms before pointing it at private code.

# ==========================================================================================
# GitHub (needed to read pull requests and post reviews)
# ==========================================================================================
# Fine-grained personal access token for your test repository: Pull requests (read & write).
GITHUB_TOKEN=

# ==========================================================================================
# WHICH provider(s) to use, and in what order:   LLM_PROVIDER=...
# ==========================================================================================
#   auto                 DEFAULT. Every FREE or free-credit provider with its fields filled in
#                        below, in the order they appear in this file (top = tried first).
#                        PAID providers are skipped, so a forgotten paid key can never be
#                        billed by accident.
#
#   groq                 ONLY Groq. If it hits its daily limit the review fails; nothing else
#   gemini               is tried. The same goes for any single name: ONLY that provider.
#   ollama               Any name from the sections below is valid: groq, cerebras, gemini,
#                        github, mistral, sambanova, openrouter, huggingface, ollama, nvidia,
#                        fireworks, together, deepseek, moonshot, openai, anthropic, custom
#
#   groq,gemini,ollama   A FALLBACK CHAIN, tried left to right. It moves to the next provider
#                        when one is rate limited, out of quota, or down. A bad key or a bad
#                        request does NOT fall through: it fails loudly so you notice.
#
#   deepseek             A PAID provider is used only when you name it here (alone or in a
#                        chain, e.g. groq,deepseek), or when LLM_ALLOW_PAID=1 lets `auto`
#                        include paid providers (last in line).
#
# Naming a provider whose fields below are empty is an error that tells you which to fill in.
LLM_PROVIDER=auto
LLM_ALLOW_PAID=0

# Hard spending caps PER RUN (one invocation of the agent), applied to each provider. The agent
# refuses to make a call that would pass them. The defaults are far above a normal review and
# far below an accident (a bug, a huge PR). Write `none` to remove a cap. Raise them if you
# review very large PRs; keep them low while you use a paid key.
LLM_MAX_CALLS_PER_RUN=100
LLM_MAX_TOKENS_PER_RUN=200000

# ==========================================================================================
# FREE TIERS  (rate-limited, no card needed)
# Only Groq has been tested against a live account. The others use documented endpoints and
# default model names that may have changed: run `python experiments/list_models.py <name>`
# to see what your key can use, then set that provider's *_MODEL line.
# ==========================================================================================

# --- groq ---------------  https://console.groq.com/keys                         [TESTED]
# Free tier: 1000 requests/day, 8000 tokens/minute. The agent paces itself under this.
GROQ_API_KEY=
# Optional. Default openai/gpt-oss-120b. Smaller/faster: openai/gpt-oss-20b
GROQ_MODEL=

# --- cerebras -----------  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Optional. Default gpt-oss-120b
CEREBRAS_MODEL=

# --- gemini (Google) ----  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default gemini-2.5-flash
GEMINI_MODEL=

# --- github (GitHub Models)  https://github.com/marketplace/models
# A GitHub token with the "models:read" permission. A SEPARATE variable from GITHUB_TOKEN
# above, so the two can have different permissions.
GITHUB_MODELS_TOKEN=
# Optional. Default openai/gpt-4.1-mini
GITHUB_MODELS_MODEL=

# --- mistral ------------  https://console.mistral.ai/api-keys  ("Experiment" free plan)
MISTRAL_API_KEY=
# Optional. Default mistral-small-latest
MISTRAL_MODEL=

# --- sambanova ----------  https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# Optional. Default gpt-oss-120b
SAMBANOVA_MODEL=

# --- openrouter ---------  https://openrouter.ai/keys
# Use model ids ending in :free. Small daily request limit.
OPENROUTER_API_KEY=
# Optional. Default openai/gpt-oss-20b:free
OPENROUTER_MODEL=

# --- huggingface --------  https://huggingface.co/settings/tokens
# The token needs the "Make calls to Inference Providers" permission. Small monthly credit.
HF_TOKEN=
# Optional. Default openai/gpt-oss-120b
HF_MODEL=

# --- ollama (runs on YOUR machine: no quota, no key, nothing leaves your computer) ---------
# Turned on by naming a model you have pulled, e.g.   ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=
# Optional. Default http://localhost:11434/v1
OLLAMA_BASE_URL=

# ==========================================================================================
# FREE SIGNUP CREDIT  (used by `auto`, after the free tiers above)
# The credit is free until it runs out. If you have a card on file the provider may start
# billing afterwards, so check your account settings before filling these in.
# ==========================================================================================

# --- nvidia (NIM) -------  https://build.nvidia.com
NVIDIA_API_KEY=
# Optional. Default openai/gpt-oss-120b
NVIDIA_MODEL=

# --- fireworks ----------  https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# Optional. Default accounts/fireworks/models/gpt-oss-120b
FIREWORKS_MODEL=

# --- together -----------  https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Optional. Default openai/gpt-oss-120b
TOGETHER_MODEL=

# ==========================================================================================
# PAID  (never used by `auto`; used only when named in LLM_PROVIDER or LLM_ALLOW_PAID=1)
# No free tier. Every call costs money from the first one.
# ==========================================================================================

# --- deepseek -----------  https://platform.deepseek.com/api_keys   (very cheap, not free)
DEEPSEEK_API_KEY=
# Optional. Default deepseek-chat
DEEPSEEK_MODEL=

# --- moonshot (Kimi) ----  https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=
# REQUIRED if you use it: copy a model id from the console (no default is set).
MOONSHOT_MODEL=

# --- openai (ChatGPT's API)  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Default gpt-4.1-mini
OPENAI_MODEL=

# --- anthropic (Claude) --  https://console.anthropic.com/settings/keys
# Reached through Anthropic's OpenAI-compatibility endpoint.
ANTHROPIC_API_KEY=
# Optional. Default claude-haiku-5-5
ANTHROPIC_MODEL=

# ==========================================================================================
# ANY OTHER OpenAI-compatible service (Cloudflare, xAI, Z.ai, a self-hosted server, ...)
# All three are required to turn it on.
# ==========================================================================================
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
